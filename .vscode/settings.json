{
    "deno.enablePaths": [
        "./DevTools/"
    ],
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        ".idea": true,
        ".run": true,
        ".vs": true,
        "**/bin": false,
        "**/obj": true,
    },
    "cSpell.words": [
        "CICD",
        "denoland",
        "gamedev",
        "Kinson",
        "kinsondigital",
        "ncipollo",
        "nupkg",
        "OPTOUT",
        "pwsh",
        "REPONAME",
        "Tele",
        "Velaptor"
    ],
    "[github-actions-workflow]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    }
}